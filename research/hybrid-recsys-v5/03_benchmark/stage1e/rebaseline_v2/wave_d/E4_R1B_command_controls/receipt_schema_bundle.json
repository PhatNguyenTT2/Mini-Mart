  "cross_receipt_validation_rules": [
    {
      "rule_id": "R01_PACKET_CHAIN",
      "rule": "Every receipt packet_sha256 equals the exact frozen packet hash; every command_id, phase, ordinal, timeout, cwd and argv equals its packet record."
    },
    {
      "rule_id": "R02_CREATE_ONCE_IDENTITY",
      "rule": "receipt_id and final path are unique and absent before atomic rename; candidate_row_id and run_id are identical across all receipts and match the run marker."
    },
    {
      "rule_id": "R03_SEQUENTIAL_GATE",
      "rule": "Ordinal N may start only after every lower ordinal receipt strict-validates with PASS; failure or BLOCKED stops all later ordinals."
    },
    {
      "rule_id": "R04_AUTHORITY_BINDING",
      "rule": "A process may be attempted only when confirmed and execution_authorized are true and both receipt hashes bind the same packet plus a future E5-R1 pass. The current lane values are false and therefore cannot launch."
    },
    {
      "rule_id": "R05_NO_AUTO_RETRY",
      "rule": "retry_policy equals NO_AUTO_RETRY and retry_count equals 0 in every receipt; any second attempt under the same packet/run_id is invalid."
    },
    {
      "rule_id": "R06_PATH_SAFETY",
      "rule": "Every path re-resolves beneath its declared namespace at each use; any reparse point, symlink, junction, ADS, case collision, undeclared nesting, extra file or changed final path is fatal."
    },
    {
      "rule_id": "R07_HASH_REPLAY",
      "rule": "Every input and output hash is recomputed from bytes using the declared policy; a stated hash is never accepted without byte replay."
    },
    {
      "rule_id": "R08_SOURCE_IMMUTABILITY",
      "rule": "The verified source remote, full commit, submodule map and tree hash equal all downstream bindings; any later mutation stales the chain."
    },
    {
      "rule_id": "R09_ENVIRONMENT_IMMUTABILITY",
      "rule": "The installed environment aggregate hash equals every preprocessing/run/evaluation binding; dependency or interpreter drift blocks."
    },
    {
      "rule_id": "R10_DATA_LINEAGE",
      "rule": "Every training/evaluation input resolves through the exact raw-to-processed-to-split lineage receipt; labels or file presence cannot substitute."
    },
    {
      "rule_id": "R11_RESOURCE_CHAIN",
      "rule": "Preflight and run/evaluation observations agree on physical GPU UUID/index/model/total memory and packet resource limits; missing telemetry over 60 seconds or any breach fails."
    },
    {
      "rule_id": "R12_TEST_SEAL",
      "rule": "All current receipts must record test_set_opened NO and test gate SEALED; any attempted TEST path/ID open is a terminal incident and cannot produce PASS."
    },
    {
      "rule_id": "R13_EVALUATOR_BINDING",
      "rule": "Evaluation binds standalone evaluator/adapter hashes and argv, the one frozen v5 spec path/hash, metric/cutoff/averaging/candidate/mask/tie contracts, and exact run outputs."
    },
    {
      "rule_id": "R14_FINAL_SET_EQUALITY",
      "rule": "Finalization requires equality for receipt, log and output sets, validates every schema with both parsers plus collision scanner, replays every hash, and rejects any missing or extra path."
    },
    {
      "rule_id": "R15_FAILURE_HONESTY",
      "rule": "Unavailable or unknown values remain explicit failures/blockers. A free-form status label, null-to-empty coercion, guessed default, or inferred evidence cannot produce PASS."
    }
  ],
