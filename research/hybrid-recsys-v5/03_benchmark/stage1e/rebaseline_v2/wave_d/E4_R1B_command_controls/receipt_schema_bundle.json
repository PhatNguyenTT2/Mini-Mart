{
  "schema_version": "stage1e-rebaseline-v2-e4-r1b-receipt-schema-bundle-1.0",
  "artifact": "receipt_schema_bundle",
  "lane_id": "E4_R1B_command_controls",
  "created_at": "2026-08-22",
  "draft_only": true,
  "executable": false,
  "schema_language": {
    "name": "E4_R1_CLOSED_RECEIPT_SCHEMA",
    "version": "1.0",
    "semantics": "Each schema is closed. Every required_fields key must exist. No key outside required_fields or optional_fields is allowed. Field definitions and mechanical rules are conjunctive.",
    "validator_path": null,
    "validator_raw_sha256": null,
    "validator_binding_state": "BLOCKING_UNRESOLVED_E4_R1_PREREQUISITE"
  },
  "encoding_and_hash_policy": {
    "json_encoding": "UTF-8_WITHOUT_BOM",
    "strict_decode": true,
    "duplicate_keys": "REJECT_AT_EVERY_OBJECT_DEPTH",
    "case_colliding_keys": "REJECT_UNICODE_CASEFOLD_AT_EVERY_OBJECT_DEPTH",
    "standard_json_parser_required": true,
    "powershell_convertfrom_json_required": true,
    "text_hash": "STRICT_UTF8_DECODE_REPLACE_CRLF_WITH_LF_THEN_SHA256",
    "binary_hash": "SHA256_EXACT_BYTES",
    "hash_hex": "LOWERCASE_64_HEX",
    "paths": "FORWARD_SLASH_RELATIVE_TO_DECLARED_NAMESPACE",
    "path_sort": "ASCENDING_UTF8_BYTE_ORDER"
  },
  "closed_nested_types": {
    "hash_entry": {
      "closed": true,
      "required_fields": ["path", "artifact_kind", "hash_policy", "sha256", "bytes"],
      "optional_fields": [],
      "field_rules": {
        "path": "nonempty relative string; no dot segments, backslash, drive, ADS, glob, or case collision",
        "artifact_kind": "TEXT or BINARY",
        "hash_policy": "CANONICAL_LF_SHA256 for TEXT; EXACT_BYTES_SHA256 for BINARY",
        "sha256": "lowercase 64-hex string",
        "bytes": "integer >= 0 under the selected hash policy"
      }
    },
    "tool_identity": {
      "closed": true,
      "required_fields": ["path", "raw_sha256", "version", "resolved_final_path", "reparse_point"],
      "optional_fields": [],
      "field_rules": {
        "path": "absolute literal path",
        "raw_sha256": "lowercase 64-hex string",
        "version": "nonempty exact string",
        "resolved_final_path": "absolute literal final path contained by declared namespace",
        "reparse_point": "constant false"
      }
    },
    "submodule_entry": {
      "closed": true,
      "required_fields": ["path", "url", "expected_full_commit", "observed_full_commit", "status", "tree_sha256"],
      "optional_fields": [],
      "field_rules": {
        "path": "normalized source-relative path",
        "url": "exact frozen URL",
        "expected_full_commit": "full lowercase 40-hex Git commit",
        "observed_full_commit": "must equal expected_full_commit",
        "status": "CLEAN_MATCH",
        "tree_sha256": "lowercase 64-hex string"
      }
    },
    "resource_sample": {
      "closed": true,
      "required_fields": ["observed_at_utc", "controller_pid", "child_pids", "gpu_index", "gpu_uuid", "gpu_model", "gpu_total_vram_mib", "gpu_free_vram_mib", "packet_gpu_vram_mib", "gpu_utilization_percent", "process_tree_cpu_percent", "process_tree_rss_mib", "process_tree_commit_mib"],
      "optional_fields": [],
      "field_rules": {
        "observed_at_utc": "RFC3339 UTC",
        "controller_pid": "integer > 0",
        "child_pids": "sorted unique integer array",
        "gpu_index": "integer >= 0",
        "gpu_uuid": "nonempty exact string",
        "gpu_model": "nonempty exact string",
        "gpu_total_vram_mib": "integer > 0",
        "gpu_free_vram_mib": "integer >= 0",
        "packet_gpu_vram_mib": "integer >= 0",
        "gpu_utilization_percent": "number from 0 through 100",
        "process_tree_cpu_percent": "number >= 0",
        "process_tree_rss_mib": "number >= 0",
        "process_tree_commit_mib": "number >= 0"
      }
    },
    "schema_count_check": {
      "closed": true,
      "required_fields": ["check_id", "expected_schema_sha256", "observed_schema_sha256", "expected_count", "observed_count", "status"],
      "optional_fields": [],
      "field_rules": {
        "check_id": "nonempty unique string",
        "expected_schema_sha256": "lowercase 64-hex string",
        "observed_schema_sha256": "must equal expected_schema_sha256",
        "expected_count": "integer >= 0",
        "observed_count": "must equal expected_count",
        "status": "PASS"
      }
    },
    "parser_result": {
      "closed": true,
      "required_fields": ["parser_id", "parser_path", "parser_raw_sha256", "version", "status", "duplicate_keys_found", "case_colliding_keys_found"],
      "optional_fields": [],
      "field_rules": {
        "parser_id": "STANDARD_JSON or POWERSHELL_CONVERTFROM_JSON or TOKEN_COLLISION_SCANNER",
        "parser_path": "absolute literal path",
        "parser_raw_sha256": "lowercase 64-hex string",
        "version": "nonempty exact string",
        "status": "PASS",
        "duplicate_keys_found": "constant 0",
        "case_colliding_keys_found": "constant 0"
      }
    }
  },
