    {
      "id": "E01_HASH_AND_FREEZE_WHEEL_CLOSURE",
      "purpose": "Hash every wheel, read wheel METADATA and write a complete hash-locked offline closure.",
      "argv": [
        "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe",
        "run",
        "--rm",
        "--pull=never",
        "--platform",
        "linux/amd64",
        "--network",
        "none",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,nodev,size=536870912,mode=1777",
        "--user",
        "10001:10001",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "256",
        "--cpus",
        "2",
        "--memory",
        "4g",
        "--stop-timeout",
        "10",
        "--env",
        "HOME=/tmp/home",
        "--env",
        "PYTHONNOUSERSITE=1",
        "--env",
        "PYTHONDONTWRITEBYTECODE=1",
        "--env",
        "PIP_CONFIG_FILE=/dev/null",
        "--env",
        "PIP_DISABLE_PIP_VERSION_CHECK=1",
        "--env",
        "PIP_NO_CACHE_DIR=1",
        "--env",
        "PIP_NO_INDEX=1",
        "--mount",
        "type=bind,src=E:\\UIT\\cv\\materialized-environments\\hybrid-recsys-v5\\stage1e\\r6\\recbole_bpr_ml100k_py3119_cpu\\attempt-004-linux,dst=/stage1e/env",
        "--workdir",
        "/stage1e/env",
        "docker.io/library/python@sha256:2856e6af199e8128161abd320575eb9b341f3b76f017b5d0c9cd364f60d8a050",
        "/usr/local/bin/python",
        "-B",
        "-I",
        "-c",
        "import email\nimport hashlib\nimport json\nimport pathlib\nimport re\nimport zipfile\n\nroot = pathlib.Path('/stage1e/env')\nwheelhouse = root / 'wheelhouse'\nfiles = sorted(wheelhouse.iterdir(), key=lambda p: p.name.casefold())\nassert files and all(p.is_file() and not p.is_symlink() and p.suffix == '.whl' for p in files)\nforbidden = ('win32','win_amd64','macosx','aarch64','arm64','cu11','cu12','cuda','rocm')\nassert not any(token in p.name.lower() for p in files for token in forbidden)\nrows = []\nrequirements = []\nseen = set()\nfor path in files:\n    payload = path.read_bytes()\n    with zipfile.ZipFile(path) as archive:\n        metadata = [name for name in archive.namelist() if name.endswith('.dist-info/METADATA')]\n        assert len(metadata) == 1\n        message = email.message_from_bytes(archive.read(metadata[0]))\n    name = message['Name']\n    version = message['Version']\n    normalized = re.sub(r'[-_.]+', '-', name).lower()\n    assert normalized not in seen and normalized != 'recbole'\n    seen.add(normalized)\n    digest = hashlib.sha256(payload).hexdigest()\n    rows.append({'file':path.name,'bytes':len(payload),'sha256':digest,'name':name,'normalized_name':normalized,'version':version})\n    requirements.append(f'{name}=={version} --hash=sha256:{digest}')\n\nexpected = {'pip':'24.0','setuptools':'69.5.1','wheel':'0.43.0','torch':'2.2.2+cpu','numpy':'1.26.4','scipy':'1.11.4','pandas':'2.1.4','scikit-learn':'1.3.2','pyyaml':'6.0.2','tqdm':'4.66.5','colorlog':'4.7.2','colorama':'0.4.4','texttable':'1.7.0','tensorboard':'2.15.2','ray':'2.6.3','thop':'0.1.1.post2207130030','tabulate':'0.9.0','plotly':'5.18.0','psutil':'5.9.8'}\nactual = {row['normalized_name']: row['version'] for row in rows}\nassert all(actual.get(name) == version for name,version in expected.items())\nassert sum(1 for row in rows if row['normalized_name'] == 'torch' and row['version'] == '2.2.2+cpu') == 1\n(root / 'receipts/wheelhouse_manifest.json').write_text(json.dumps({'schema_version':'stage1e-r6-c1r3-linux-wheelhouse-1.0','platform':'linux/amd64','python':'3.11.9','wheel_only':True,'cpu_only':True,'recbole_absent':True,'wheels':rows}, indent=2, sort_keys=True) + '\\n', encoding='utf-8')\n(root / 'receipts/hashed_third_party_requirements.txt').write_text('\\n'.join(sorted(requirements, key=str.casefold)) + '\\n', encoding='utf-8')"
