    "dataset_terms_locator",
    "preprocessing_split_locator",
    "training_entrypoint_locator",
    "configuration_locator",
    "evaluator_locator",
    "benchmark_target_locator",
    "benchmark_target_summary",
    "task_family",
    "source_inventory",
    "scout_status",
    "unresolved_fields"
  ],
  "source_record_fields": [
    "evidence_id",
    "url",
    "authority_type",
