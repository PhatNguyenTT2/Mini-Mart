{
  "schema_version": "stage1e-rebaseline-v2-e4-r4-strict-admission-contract-1.0",
  "created_at": "2026-08-22",
  "proposal_id_pattern": "^R4-D1[ABC]-PROP-[0-9]{3}$",
  "central_bundle_id_pattern": "^R4-BUNDLE-[A-Z0-9][A-Z0-9-]{2,63}-[0-9]{3}$",
  "scout_lanes": ["R4-D1A", "R4-D1B", "R4-D1C"],
  "closed_status_sets": {
    "proposal": ["ADMIT_COMPLETE_BUNDLE_FOR_INDEPENDENT_AUDIT", "EXCLUDE_INCOMPLETE_BUNDLE", "DISPOSITIVE_REJECT"],
    "dimension": ["PASS_PRIMARY_REPLAYED", "FAIL_MISSING", "FAIL_PARTIAL", "FAIL_CONFLICT", "FAIL_INACCESSIBLE", "FAIL_INDIRECT_ONLY", "FAIL_NOT_APPLICABLE_IS_NOT_ALLOWED"],
    "source_access": ["REPLAYED_PRIMARY", "REPLAYED_AUTHORITATIVE", "INACCESSIBLE", "NOT_FOUND", "INDIRECT_ONLY", "IDENTITY_CONFLICT"]
  },
  "mandatory_dimensions": [
    {"id":"D01_AFFIRMATIVE_CODE_LICENSE","criterion":"Affirmative code license is verified for the project and pinned revision; intended reproduction/adaptation is within scope."},
    {"id":"D02_CANONICAL_DATASET_RIGHTS","criterion":"Canonical provider, exact release identity and affirmative lawful-use basis are verified."},
    {"id":"D03_BYTE_VERIFIABLE_LINEAGE","criterion":"Provider checksum or byte-verifiable acquisition and raw-to-framework-input transformation chain is available."},
    {"id":"D04_IMMUTABLE_FULL_REVISION","criterion":"A full immutable repository revision binds all code-bearing evidence."},
    {"id":"D05_ENVIRONMENT_LOCK","criterion":"Complete dependency/runtime lock, or source-owned deterministically bounded lock with no guessed version, is available."},
    {"id":"D06_EXECUTABLE_TRAIN_ENTRYPOINT","criterion":"Source-owned executable training entry point is identified at the pinned revision."},
    {"id":"D07_EXACT_PROTOCOL_CONFIG_SEEDS","criterion":"Exact preprocessing, split, configuration, tuning boundary and seed protocol are bound to the candidate."},
    {"id":"D08_EVALUATOR_SEMANTICS","criterion":"Source-owned evaluator defines metric formula, candidate set, seen-item masking, aggregation and deterministic tie policy."},
    {"id":"D09_SAME_SURFACE_NUMERIC_TARGET","criterion":"Numeric target is tied to the same framework, revision, dataset release, protocol, config and evaluator surface."},
    {"id":"D10_NO_TEST_DERIVATION","criterion":"Schema/cardinality/tuning/model selection do not derive from TEST; TEST is evaluation-only."},
    {"id":"D11_BOUNDED_V5_ADAPTER","criterion":"Current v5 data can be adapted without changing task objective, split/candidate policy or shared evaluator semantics."},
    {"id":"D12_ALL_LOCATORS_REPLAYED","criterion":"Every decision-bearing URL was opened by the scout and verified as primary or authoritative evidence."}
  ],
  "required_proposal_fields": [
    "proposal_id",
    "scout_lane",
    "framework_name",
    "repository_url",
    "full_revision",
    "dataset_name",
    "dataset_provider",
    "dataset_release_id",
    "protocol_id",
    "config_id",
    "evaluator_id",
    "numeric_target_id",
    "numeric_target",
    "task_family",
    "identity_tuple",
    "admission_matrix",
    "decision_bearing_sources",
    "unresolved_mandatory_fields",
    "dispositive_conflicts",
    "proposal_status"
  ],
  "required_source_fields": [
    "evidence_id",
    "url",
    "authority_type",
    "claim_scope",
    "immutable_binding",
    "access_status",
    "retrieved_at",
    "evidence_note"
  ],
  "identity_tuple_fields": [
    "repository_url",
    "full_revision",
    "dataset_provider",
    "dataset_release_id",
    "protocol_id",
    "config_id",
    "evaluator_id",
    "numeric_target_id"
  ],
  "admission_invariant": {
    "mandatory_dimension_count": 12,
    "required_dimension_status": "PASS_PRIMARY_REPLAYED",
    "unresolved_mandatory_field_count": 0,
    "dispositive_conflict_count": 0,
    "all_decision_bearing_source_access": ["REPLAYED_PRIMARY", "REPLAYED_AUTHORITATIVE"],
    "same_surface_join_required": true,
    "cross_join_allowed": false,
    "inference_can_satisfy_dimension": false,
    "weighted_compensation_allowed": false
  },
  "scout_output_contract": {
    "exact_filenames": ["scout_candidates.json", "source_replay_log.json", "excluded_candidate_log.json", "scout_report.md", "scout_handoff.json"],
    "extra_files_allowed": false,
    "admitted_minimum": 0,
    "admitted_maximum_per_lane": 2,
    "zero_admission_is_valid": true
  },
  "central_g0_contract": {
    "frozen_candidate_minimum": 0,
    "frozen_candidate_maximum": 3,
    "exact_identity_deduplication": true,
    "independent_central_replay_required": true,
    "central_repair_or_evidence_substitution_allowed": false,
    "zero_candidates_verdict": "NO_ADMISSIBLE_BUNDLE_STOP_FAIL_CLOSED"
  },
  "truth_state": {
    "RESULT_STATUS": "NOT_RUN",
    "TEST_SET_OPENED": "NO",
    "ACCEPTED_RESULT_ROWS": 0,
    "execution_authorized": false,
    "project_benchmark_numbers": "INVALID_FOR_PAPER"
  }
}
